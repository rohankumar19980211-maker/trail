<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Handle Authorization Header for LiteSpeed / Apache CGI
  RewriteCond %{HTTP:Authorization} ^(.*)
  RewriteRule .* - [e=HTTP_AUTHORIZATION:%1]

  # Route short API paths to corresponding PHP scripts
  RewriteRule ^api/login$ api/login.php [L,QSA]
  RewriteRule ^api/auth/login$ api/login.php [L,QSA]
  RewriteRule ^api/auth/users$ api/users.php [L,QSA]
  RewriteRule ^api/auth/me$ api/auth.php [L,QSA]
  RewriteRule ^api/products$ api/products.php [L,QSA]
  RewriteRule ^api/orders$ api/orders.php [L,QSA]
  RewriteRule ^api/seed$ api/seed.php [L,QSA]

  # SPA Routing: Fallback non-file / non-dir requests to SPA index.html
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.html [L]
</IfModule>
